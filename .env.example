# ─── SUPABASE ───────────────────────────────────────
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_key"

# ─── RAPIDAPI (una sola key para todo) ──────────────
VITE_RAPIDAPI_KEY="your_rapidapi_key"

# Hosts de cada API (no necesitan key separada, solo el host)
VITE_RAPIDAPI_HOST_YTMUSIC="youtube-music-api3.p.rapidapi.com"
VITE_RAPIDAPI_HOST_YTAPI="ytjar.p.rapidapi.com"
VITE_RAPIDAPI_HOST_YTMP3="youtube-to-mp315.p.rapidapi.com"
VITE_RAPIDAPI_HOST_SHAZAM="shazam-core.p.rapidapi.com"
VITE_RAPIDAPI_HOST_MUSICAPI="spotify23.p.rapidapi.com"

# ─── TRADUCCIÓN ─────────────────────────────────────
VITE_DEEPL_API_KEY="your_deepl_key"

# ─── IDENTIFICACIÓN DE CANCIONES ────────────────────
VITE_AUDD_API_KEY="your_audd_key"
